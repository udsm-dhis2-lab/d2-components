{
  "name": "dhis2-map",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dhis2-map/src",
  "projectType": "library",
  "tags": ["npm:public", "scope:visualizer", "scope:dhis2", "type:library"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/dhis2-map",
        "main": "packages/dhis2-map/src/index.ts",
        "tsConfig": "packages/dhis2-map/tsconfig.lib.json",
        "assets": [
          "packages/dhis2-map/package.json",
          "packages/dhis2-map/README.md"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "packages/dhis2-map/jest.config.ts" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint 'packages/dhis2-map/**/*.{ts,js,mjs,json}'"
      }
    },
    "consumer-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node packages/dhis2-map/tools/scripts/consumer-smoke.mjs"
      }
    },
    "unrelated-imports-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node packages/dhis2-map/tools/scripts/unrelated-imports-smoke.mjs"
      }
    }
  }
}
